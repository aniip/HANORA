{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=hanora;Username=hanora;Password=hanora_dev_password;Maximum Pool Size=20"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Storage": {
    "UploadPath": "uploads"
  },
  "Jwt": {
    "Issuer": "hanora-api",
    "Audience": "hanora-client",
    "TableAudience": "hanora-table",
    "SigningKey": "dev-only-hanora-signing-key-change-me-0123456789abcdef",
    "AccessMinutes": 15,
    "RefreshDays": 7,
    "TableSessionMinutes": 120
  },
  "App": {
    "BaseUrl": "http://localhost:8080"
  },
  "Midtrans": {
    "Mode": "simulation",
    "ServerKey": "",
    "ClientKey": "",
    "MerchantId": "",
    "SnapUrl": "",
    "QrisEnabled": true
  },
  "Database": {
    "AutoMigrate": false,
    "Seed": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "PublicPermitLimit": 120,
    "OrderPermitLimit": 40,
    "WebhookPermitLimit": 120,
    "StaffPermitLimit": 300,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Seed": {
    "OwnerEmail": "",
    "OwnerPassword": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hanora-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
