# ============================================================
# HANORA CAFE — environment PRODUCTION / STAGING
# Salin menjadi .env.production, isi nilai asli, lalu:
#   chmod 600 .env.production
# Jangan commit file ini.
# ============================================================

# --- Domain & TLS (Caddy) ---
DOMAIN=cafe.example.com
ACME_EMAIL=admin@example.com

# --- Database ---
# Opsi A (disarankan): database Azure/external.
# Format Npgsql untuk aplikasi:
DATABASE_CONNECTION_STRING=
# Contoh Azure:
# DATABASE_CONNECTION_STRING=Host=devnity-postgre.postgres.database.azure.com;Port=5432;Database=Hanora;Username=devnitydb;Password=GANTI_PASSWORD;SSL Mode=Require;Maximum Pool Size=20
#
# Format libpq untuk pg_dump/pg_restore (backup):
DATABASE_BACKUP_URL=
# Contoh:
# DATABASE_BACKUP_URL=postgresql://devnitydb:GANTI_PASSWORD@devnity-postgre.postgres.database.azure.com:5432/Hanora?sslmode=require
#
# Opsi B: PostgreSQL bawaan compose (jalankan dengan --profile local-db).
POSTGRES_DB=hanora
POSTGRES_USER=hanora
POSTGRES_PASSWORD=ganti-dengan-password-panjang-acak

# --- JWT (minimal 32 byte; buat dengan openssl rand -base64 48) ---
JWT_SIGNING_KEY=
JWT_ISSUER=hanora-api
JWT_AUDIENCE=hanora-client
JWT_TABLE_AUDIENCE=hanora-table
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=7
TABLE_SESSION_MINUTES=120

# --- Owner awal (dipakai sekali saat --migrate --seed) ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# --- Midtrans ---
# simulation : demo lokal tanpa Midtrans (hanya untuk Development/Testing)
# sandbox    : uji integrasi Midtrans
# production : pembayaran nyata
#
# Catatan: mode simulation DITOLAK jika ASPNETCORE_ENVIRONMENT=Production.
# Untuk deploy staging/production, ganti ke sandbox atau production.
MIDTRANS_MODE=simulation
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_SNAP_URL=
MIDTRANS_QRIS_ENABLED=true

# --- Rate limiting (opsional; default aktif) ---
RATE_LIMIT_ENABLED=true
