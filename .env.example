# ============================================================
# HANORA CAFE — contoh environment
# Salin menjadi .env lalu ganti semua nilai placeholder.
# Jangan commit file .env.
# ============================================================

# --- Docker Compose ---
POSTGRES_DB=hanora
POSTGRES_USER=hanora
POSTGRES_PASSWORD=hanora_dev_password
APP_ORIGIN=http://localhost:8080
ASPNETCORE_ENVIRONMENT=Development

# Default development: PostgreSQL bawaan compose.
# Ganti dengan connection string Azure/external jika ingin memakai DB lain.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=hanora;Username=hanora;Password=hanora_dev_password;Maximum Pool Size=20
# Contoh Azure:
# DATABASE_CONNECTION_STRING=Host=devnity-postgre.postgres.database.azure.com;Port=5432;Database=Hanora;Username=devnitydb;Password=...;SSL Mode=Require;Maximum Pool Size=20

# --- Backend jika dijalankan langsung ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=hanora;Username=hanora;Password=ganti-dengan-password-kuat;Maximum Pool Size=20
Cors__AllowedOrigins__0=http://localhost:5173
Storage__UploadPath=uploads

# --- JWT (wajib di production; development memakai fallback di compose) ---
JWT_SIGNING_KEY=
JWT_ISSUER=hanora-api
JWT_AUDIENCE=hanora-client
JWT_TABLE_AUDIENCE=hanora-table
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=7
TABLE_SESSION_MINUTES=120

# URL publik untuk QR meja (tanpa trailing slash)
APP_BASE_URL=http://localhost:8080

# --- Hardening (Tahap 10) ---
# Rate limiting aktif secara default; matikan hanya untuk pengujian lokal.
RATE_LIMIT_ENABLED=true
# Path kunci Data Protection di container (dipetakan ke volume).
# DataProtection__KeysPath=/var/hanora/keys

# --- Seed owner (wajib diisi sebelum API pertama kali berjalan) ---
# Jika kosong, akun owner tidak dibuat. Password minimal 12 karakter.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# --- Midtrans (dipakai mulai Tahap 8) ---
MIDTRANS_MODE=simulation
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_SNAP_URL=
MIDTRANS_QRIS_ENABLED=true

# --- Simulasi development ---
# Halaman simulasi pembayaran aktif otomatis saat MIDTRANS_MODE=simulation.
# Tidak ada secret tambahan yang diperlukan.
